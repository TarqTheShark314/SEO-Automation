# PieBot SEO - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Core Application Settings
# ===========================================
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=your-super-secret-key-change-this

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_PASSWORD=your-secure-password
DATABASE_URL=postgresql+asyncpg://piebot:your-secure-password@localhost:5432/piebot_seo

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# AI Services
# ===========================================
# Claude (Anthropic) - Primary AI provider
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (Optional fallback)
OPENAI_API_KEY=sk-your-openai-key-here

# ===========================================
# Google Services
# ===========================================
# OAuth credentials for GSC, GA4, GBP
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ===========================================
# SEMrush Integration
# ===========================================
SEMRUSH_API_KEY=your-semrush-api-key

# ===========================================
# Yext Integration (Local SEO)
# ===========================================
YEXT_API_KEY=your-yext-api-key
YEXT_ACCOUNT_ID=your-yext-account-id

# ===========================================
# Monitoring (Optional)
# ===========================================
SENTRY_DSN=https://your-sentry-dsn
PROMETHEUS_ENABLED=true

# ===========================================
# CORS Settings
# ===========================================
CORS_ORIGINS=http://localhost:3000,https://app.bakemorepies.com

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
